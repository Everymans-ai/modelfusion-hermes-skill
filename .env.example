# ModelFusion API key — required.
# Obtain from your ModelFusion dashboard or contact your founder-distributed
# demo slug owner. Never commit the real value.
MODELFUSION_API_KEY=sk_modelfusion_xxxxxxxxxxxxxxxxxxxx

# Optional — override the default endpoint. Use for self-hosted ModelFusion
# deployments (air-gapped Docker, customer VPC, etc).
# MODELFUSION_ENDPOINT=https://modelfusion.internal.example.com/api/fusion

# Optional — for live e2e tests only. Setting this enables the @live spec group
# in e2e/api-contract.spec.ts.
# MODELFUSION_DEMO_KEY=sk_modelfusion_demo_xxxxxxxxxxxxxxxxxxxx
# MODELFUSION_API_URL=https://modelfusion-api.vercel.app/api/fusion
